<?xml version="1.0" encoding="utf-8"?>
<!-- Installation identity must not be cloned by Android backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="no_local.sqlite" />
        <exclude domain="file" path="no_local.sqlite-wal" />
        <exclude domain="file" path="no_local.sqlite-shm" />
        <exclude domain="file" path="no_local.sqlite-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="no_local.sqlite" />
        <exclude domain="file" path="no_local.sqlite-wal" />
        <exclude domain="file" path="no_local.sqlite-shm" />
        <exclude domain="file" path="no_local.sqlite-journal" />
    </device-transfer>
</data-extraction-rules>
